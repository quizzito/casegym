[run]
command = "bash start_replit.sh"

[env]
PYTHONPATH = "backend"

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"
waitForPort = 8080

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start_replit.sh"